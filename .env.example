# DEVELOPMENT — Laragon / Windows
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ppob_bumdes

# Used to sign the session cookie (HMAC-SHA256) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Used to encrypt provider credentials at rest (Digiflazz API keys, etc.)
# before they're stored in the database — AES-256-GCM, 32 random bytes,
# base64-encoded. Generate the same way as AUTH_SECRET above. Losing this
# key makes every stored credential unrecoverable; rotating it requires
# re-entering all provider credentials through the Settings UI.
CREDENTIALS_ENCRYPTION_KEY=

# Folder berkas APK aplikasi mitra (di luar folder aplikasi, supaya tidak
# ikut terhapus saat git pull / build). Kosongkan untuk memakai ./storage/apk
APK_STORAGE_DIR=/home/digides/storage/apk

# Folder gambar halaman depan yang diunggah Super Admin
MEDIA_STORAGE_DIR=/home/digides/storage/media
