# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env files — never commit real credentials
.env
.env.local
.env.*.local

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# local tool config (Claude Code) — machine/session-specific, not project source
.claude/

# throwaway verification scripts (underscore-prefixed convention used during
# development; always deleted after use, never meant to reach the repo)
scripts/_*

# berkas APK yang diunggah lewat Super Admin — 30 MB per berkas, tidak
# pernah masuk git (di server letaknya diatur lewat APK_STORAGE_DIR)
/storage/

# catatan berjalan saat pengembangan, tidak pernah ikut commit
dev.log
